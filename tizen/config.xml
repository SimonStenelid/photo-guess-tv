<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://photo-guess-tv.local/app" version="0.4.2" viewmodes="maximized">
  <tizen:application id="PhotoGuess.TV" package="PhotoGuess" required_version="5.5"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <name>Photo Guess TV</name>
  <icon src="icon.png"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <access origin="*"/>
  <tizen:content-security-policy>default-src 'self'; connect-src http: https:; img-src 'self' http: https:</tizen:content-security-policy>
  <tizen:setting screen-orientation="landscape" context-menu="disable" hwkey-event="enable"/>
</widget>
